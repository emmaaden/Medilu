# ---------------------------------------------------------------------------
# Medilu — variables de entorno
# Copiá este archivo a ".env" y completá los valores. NUNCA subas .env a git.
# ---------------------------------------------------------------------------

# Servidor
PORT=3000
NODE_ENV=development

# Secreto para firmar las cookies de sesión (usá una cadena larga y aleatoria)
SESSION_SECRET=

# Orígenes permitidos para CORS, separados por coma (ej: https://tuapp.com,https://www.tuapp.com)
# Dejar vacío en desarrollo permite cualquier origen.
ALLOWED_ORIGINS=

# Emails del equipo de la plataforma, separados por coma (Fase L). Acceden al panel
# /dashboard/plataforma: activan y renuevan los planes de las clínicas y editan precios.
PLATAFORMA_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Supabase (base de datos, auth y storage)
# ---------------------------------------------------------------------------
SUPABASE_URL=
# IMPORTANTE: usar la clave 'service_role' SOLO en el servidor. Nunca exponerla al cliente.
SUPABASE_KEY=
# Clave 'anon'/'public' de Supabase. Es segura de exponer al cliente; la usa la
# página de recuperación de contraseña (/reset-password) vía /api/public-config.
SUPABASE_KEY_PUBLIC=

# URL pública de la app (enlaces de los emails, robots.txt y sitemap.xml).
# En producción definila SIEMPRE (ej: https://medilu.com.ar).
# Si se deja vacía, se deduce del request (ej: http://localhost:3000).
APP_URL=

# Cadena de conexión Postgres de Supabase para almacenar las sesiones (connect-pg-simple).
# Si se deja vacía, se usa almacenamiento en memoria (solo para desarrollo).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Google Calendar (Service Account)
# ---------------------------------------------------------------------------
TYPE=service_account
PROJECT_ID=
PRIVATE_KEY_ID=
# La private key va entre comillas; los saltos de línea pueden ir como \n
PRIVATE_KEY=""
CLIENT_EMAIL=
CLIENT_ID=
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_X509_CERT_URL=
UNIVERSE_DOMAIN=googleapis.com

# ---------------------------------------------------------------------------
# Email (Nodemailer) — confirmación y recordatorios de turnos.
# Si se dejan vacías, no se envían emails (el resto del sistema funciona igual).
# Con Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, y EMAIL_PASS = "app password".
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Solo para pruebas: si se completa, los mails a pacientes que carga un profesional
# (datos de acceso / aviso de vinculación) van a esta casilla en vez de al paciente.
# Dejar VACÍO en producción.
MAIL_PRUEBA=

# Token secreto para disparar los recordatorios desde un cron externo
# (POST /internal/send-reminders con header x-reminders-token). Usá una cadena larga.
REMINDERS_TOKEN=

# ---------------------------------------------------------------------------
# Mercado Pago — cobro de la suscripción de las CLÍNICAS (Fase M). El paciente no paga.
# Sin MP_ACCESS_TOKEN el pago online queda apagado y se contrata por WhatsApp.
# En pruebas usá el access token de PRUEBA del usuario vendedor de prueba (TEST-...).
# ---------------------------------------------------------------------------
MP_ACCESS_TOKEN=
# Clave secreta de los webhooks (Tus integraciones → Webhooks). URL a configurar:
#   https://<tu-dominio>/api/pagos/mp/webhook  (eventos: Planes y suscripciones)
MP_WEBHOOK_SECRET=
# Adónde vuelve el admin después de pagar. Opcional: por defecto APP_URL + /dashboard/plan?pago=mp.
# Tiene que ser PÚBLICA y con https: Mercado Pago rechaza localhost («Invalid value for back_url»).
# En desarrollo: la URL https de un túnel (p. ej. cloudflared) + /dashboard/plan?pago=mp.
MP_BACK_URL=

# Control diario de suscripciones (Fase M2): corre solo dentro del servidor (al arrancar
# y cada 24 h). En hostings que duermen, dispararlo desde un cron externo:
#   POST /internal/control-suscripciones  con header x-cron-token: <CRON_TOKEN>
# Si se deja vacío se usa REMINDERS_TOKEN.
CRON_TOKEN=

# ---------------------------------------------------------------------------
# Twilio (recordatorios por WhatsApp — opcional, Fase 1)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Dictado por voz (whisper.cpp local — ver whisper/setup.ps1)
# ---------------------------------------------------------------------------
# URL del servidor de whisper.cpp. El audio de las consultas solo viaja a este host.
WHISPER_URL=http://127.0.0.1:8178
# Solo desarrollo: 1 = guarda cada tramo dictado en whisper/muestras/ para medir modelos
# con `npm run whisper:medir`. Dictar solo casos de prueba, nunca datos de pacientes.
DICTADO_GUARDAR_MUESTRAS=0
