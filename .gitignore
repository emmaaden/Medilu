# Dependencias
node_modules/

# Variables de entorno
.env

# Configuración del editor
.vscode/

# Archivos de servicio o claves privadas
*.json
# Excepcion: los JSON de configuracion del frontend si se versionan
!frontend/**/*.json

# Logs y archivos temporales
*.log
*.tmp


# Motor de dictado local (binarios y modelos descargados por whisper/setup.ps1)
whisper/bin/
whisper/models/
# Grabaciones de prueba del dictado y transcripciones del benchmark (whisper/benchmark.js)
whisper/muestras/
whisper/mediciones/

# Seed de datos de prueba (la clave de DEV está en config.js; salida/ tiene cuentas, mails y logs)
backend/db/seed/

# Pruebas en seco de las fases de RLS (solo locales)
faseP_prueba_en_seco.sql
faseU_prueba_en_seco.sql

# Otros entornos (p. ej. backend/.env.produccion con las credenciales de prod)
.env.*
!.env.example
